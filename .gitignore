# Databases
*.db
*.db-shm
*.db-wal

# Secrets & runtime
secrets.yaml
.ha_run.lock
.cache/

# Logs
*.log*

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# HA internal storage (tokens, registry, …) — track Lovelace UI only
.storage/*
!.storage/lovelace
!.storage/lovelace_dashboards
!.storage/lovelace_resources
!.storage/lovelace.*

# Cloud / remote access (contains private keys)
.cloud/

# HACS integrations — reinstall via HACS (hacs/ already listed below)
custom_components/

# Runtime markers
.HA_VERSION
.shopping_list.json